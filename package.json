{
  "name": "be-ai-eon",
  "version": "1.0.0",
  "description": "EON AI Backend",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch src/server.ts",
    "build": "tsc",
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "studio": "cross-env PORT=4111 mastra dev",
    "studio:build": "mastra build",
    "rag:migrate": "tsx src/scripts/rag-migrate.ts",
    "rag:sync": "tsx src/scripts/rag-sync.ts",
    "rag:sync:full": "tsx src/scripts/rag-sync.ts --full",
    "rag:search": "tsx src/scripts/rag-search.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "cross-env": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.21",
    "@ai-sdk/openai-compatible": "3.0.15",
    "@azure/msal-node": "^6.0.1",
    "@chat-adapter/teams": "^4.41.0",
    "@mastra/core": "^1.67.0",
    "@mastra/duckdb": "^1.8.0",
    "@mastra/editor": "^0.15.0",
    "@mastra/express": "^1.5.11",
    "@mastra/loggers": "^1.3.1",
    "@mastra/memory": "^1.30.0",
    "@mastra/observability": "^1.17.6",
    "@mastra/pg": "^1.25.0",
    "@microsoft/teams.apps": "^2.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "mastra": "^1.30.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
