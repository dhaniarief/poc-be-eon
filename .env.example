# ==================================================
# APPLICATION
# ==================================================

NODE_ENV=development
PORT=3001
HOST=0.0.0.0


# ==================================================
# DEVELOPMENT FEATURES
# ==================================================

ENABLE_DEV_UI=true
ENABLE_DEV_TOKEN_ENDPOINT=true
ENABLE_RUN_DEBUG=true


# ==================================================
# LOGGING
# ==================================================

LOG_LEVEL=debug


# ==================================================
# AI
# ==================================================

OPENAI_API_KEY=

OLLAMA_BASE_URL=
OLLAMA_MODEL=


# ==================================================
# WEB SEARCH
# ==================================================

SEARXNG_BASE_URL=http://localhost:8080
SEARXNG_TIMEOUT_MS=10000
SEARXNG_MAX_RESULTS=5
SEARXNG_SNIPPET_MAX_CHARS=700

# ==================================================
# JWT
# ==================================================

JWT_SECRET=
JWT_ISSUER=eon-ai-backend
JWT_AUDIENCE=eon-ai-client
JWT_EXPIRES_IN=8h

CRM_TENANT_ID=
CRM_CLIENT_ID=
CRM_CLIENT_SECRET=
CRM_BASE_URL=

FINOPS_BASE_URL=

SHAREPOINT_HOSTNAME=eonchemicals1.sharepoint.com
SHAREPOINT_SITE_PATH=
SHAREPOINT_MSDS_LIBRARY_NAME=MSDS File

# ==================================================
# MASTRA STUDIO / STORAGE / MEMORY
# ==================================================
# PostgreSQL is optional for basic runtime, but required for persistent
# conversation memory and Agent Editor versioning.
DATABASE_URL=
MASTRA_DB_SCHEMA=mastra
MASTRA_EDITOR_DB_SCHEMA=mastra_editor
MASTRA_SERVICE_NAME=eon-ai
MASTRA_MEMORY_LAST_MESSAGES=8
LOCAL_AGENT_MAX_STEPS=12
CLOUD_AGENT_MAX_STEPS=12
AGENT_MAX_OUTPUT_TOKENS=6000
# Keep false initially. Observational Memory invokes additional model work.
MASTRA_OBSERVATIONAL_MEMORY=false

TEAMS_APP_ID=
TEAMS_APP_PASSWORD=
TEAMS_APP_TENANT_ID=

CLIENT_ID=
CLIENT_SECRET=
TENANT_ID=

# ==================================================
# SHAREPOINT SOP / IK RAG (NO PGVECTOR REQUIRED)
# ==================================================

SHAREPOINT_SOP_HOSTNAME=
SHAREPOINT_SOP_SITE_PATH=
SHAREPOINT_SOP_LIST_ID=

RAG_SOURCE_KEY=

# Keep SOP/IK and Product Knowledge as two independent RAG sources.
RAG_SOP_SYNC_ENABLED=true

SHAREPOINT_PRODUCT_HOSTNAME=
SHAREPOINT_PRODUCT_SITE_PATH=
SHAREPOINT_PRODUCT_LIST_ID=
RAG_PRODUCT_SOURCE_KEY=
RAG_PRODUCT_SYNC_ENABLED=true
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBED_BATCH_SIZE=32
RAG_MIN_SCORE=0.20
RAG_SEARCH_TOP_K=5
RAG_CHUNK_SIZE_CHARS=1800
RAG_CHUNK_OVERLAP_CHARS=250

RAG_SYNC_ENABLED=true
RAG_SYNC_ON_START=true
RAG_SYNC_INTERVAL_MS=300000

CRM_REQUEST_TIMEOUT_MS=20000
SALES_QUERY_TIMEOUT_MS=60000